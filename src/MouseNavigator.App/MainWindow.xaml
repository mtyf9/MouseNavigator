<Window
    x:Class="MouseNavigator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MouseNavigator">
  <Grid Background="Transparent" RequestedTheme="Dark">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Padding="20,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <FontIcon Glyph="&#xE962;" FontSize="17"/><TextBlock Text="MouseNavigator" FontWeight="SemiBold"/>
    </StackPanel></Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="210" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#293E5E"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#355177"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#203650"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="悬浮导航" Icon="Home" Tag="home" IsSelected="True"/>
        <NavigationViewItem Content="悬浮窗菜单" Icon="AllApps" Tag="profiles"/>
        <NavigationViewItem Content="动作库" Icon="Library" Tag="actions"/>
      </NavigationView.MenuItems>
      <ScrollViewer x:Name="PageScroll">
        <StackPanel Padding="24,24,24,32" Spacing="24" MaxWidth="1360" HorizontalAlignment="Stretch">
          <StackPanel x:Name="HomePage" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="让操作跟随鼠标" FontSize="32" FontWeight="SemiBold"/>
              <TextBlock Text="按住中键，移向一个方向，松开即可执行。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15"/>
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
              <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8"><TextBlock Text="中键悬浮球" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="轻点保留普通中键点击；拖动唤出菜单。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" IsOn="True" OnContent="已启用" OffContent="已暂停" Toggled="EnabledSwitch_Toggled"/>
              </Grid>
            </Border>
            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="16"><TextBlock Text="窗口缩略图预览" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE76B;" FontSize="28"/><TextBlock Text="当前桌面的窗口" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" FontSize="28"/></StackPanel>
                  <TextBlock Text="移入窗口预览，保持中键选择缩略图，松开切换。最小化的窗口会自动恢复。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="16"><TextBlock Text="随应用变化的菜单" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="触发时识别当前应用，自动使用对应菜单；其他应用使用全局导航。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock Text="移回中心、移出圆环或按 Esc 可取消。" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="24">
              <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <TextBlock Text="开机启动" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StartupHint" Text="登录 Windows 后自动运行，启动后驻留托盘。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="已开启" OffContent="已关闭" Toggled="StartupSwitch_Toggled"/>
              </Grid>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="24">
              <StackPanel Spacing="12">
                <TextBlock Text="配置备份" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="备份全部菜单、快捷键、图片和预设，包含尚未保存的菜单编辑。还原会替换现有配置。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="BackupButton" Content="备份配置" Click="BackupButton_Click"/>
                  <Button x:Name="RestoreButton" Content="还原配置" Click="RestoreButton_Click"/>
                </StackPanel>
                <TextBlock Text="关闭主窗口后继续在托盘运行；点击托盘图标可重新打开，右键可暂停或退出。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Border>
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="准备就绪" Message="切换到任意应用，按住中键并移动试试。"/>
            <StackPanel Spacing="8"><TextBlock Text="最近一次导航" FontWeight="SemiBold"/><TextBlock x:Name="ContextText" Text="尚未触发" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
          </StackPanel>
          <StackPanel x:Name="ProfilesPage" Visibility="Collapsed" Spacing="20"/>
          <StackPanel x:Name="ActionsPage" Visibility="Collapsed" Spacing="20">
            <TextBlock Text="动作库" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="已接入的 Windows 操作，可供悬浮窗菜单使用。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="ActionsList" Spacing="12"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
